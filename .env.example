# Konfigurasi Timezone (default: Asia/Makassar)
TIMEZONE=Asia/Makassar

# Path Database SQLite (default: bot.db)
DB_PATH=bot.db

# Log Level Whatsmeow (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Nomor WhatsApp Admin awal (pisahkan dengan koma jika lebih dari satu)
# Contoh: ADMIN_NUMBERS=6281234567890,6289876543210
ADMIN_NUMBERS=6281234567890
 
# (Opsional) API Key untuk Otak AI Lisa (dapatkan gratis di: https://aistudio.google.com)
# Jika diisi, AI Lisa memiliki kemampuan percakapan cerdas tanpa batas untuk menjawab
# pertanyaan santai, curhat kuliah, materi kuliah, atau typo ekstrem.
# GEMINI_API_KEY=AIzaSy...

# (Opsional) Persona / kepribadian AI Lisa saat ngobrol. Kalau tidak diisi, dipakai
# persona default (santai, pakai partikel "mi", singkatan chat, balasan pendek).
# Tulis satu baris per ciri, atau pakai file terpisah supaya rapi.
# BOT_PERSONA=Santai banget, balasan pendek-pendek, sering pakai partikel "mi"...
# BOT_PERSONA_FILE=persona.txt
